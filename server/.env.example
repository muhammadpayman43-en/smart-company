PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/spice_management
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
API_HOST=127.0.0.1
LAN_ENABLED=false
SERVER_MODE=lan
# Optional: DATABASE_WORKER=absolute path to the app executable built for this server
# Optional: SQLITE_DATA_DIR=absolute directory for new organizations' central SQLite files
# For cloud deployment behind a TLS reverse proxy:
# SERVER_MODE=cloud
# PUBLIC_API_URL=https://api.example.com
# TRUST_PROXY=loopback
